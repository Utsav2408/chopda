# Copy to .env for local development. Never commit the real .env file.
# Local dev values only — point at a Neon DEV branch seeded with FAKE data, never production.
# See docs/invoice-tracker-database-and-security-architecture.md for what each value protects.

# --- Database (server-only) ---
# Pooled connection string, used by the running app.
# Prefer connecting as limited role `app_user` once grants are set (B1-04).
# Local Docker example (owner role for convenience while migrating):
#   postgres://chopda:chopda@localhost:5432/chopda_test
# App role after migrations: postgres://app_user:chopda_app@localhost:5432/chopda_test
DATABASE_URL="postgres://user:password@localhost:5432/chopda_dev"
# Direct (non-pooled) connection string, used only for running migrations (owner).
DATABASE_URL_DIRECT="postgres://user:password@localhost:5432/chopda_dev"

# --- Sessions and crypto (server-only) ---
# Long random value. Generate your own for local dev, e.g.: openssl rand -base64 48
SESSION_SECRET="replace-with-a-long-random-dev-only-value"
# AES-256-GCM key for field encryption (bank details, PAN, etc). Dev-only value; never reuse a prod key.
ENCRYPTION_KEY="replace-with-a-long-random-dev-only-value"

# --- File storage (server-only) ---
# "local" during build; switch to "r2" (or another durable provider) before any deployment
# that accepts uploads (P5-15 / B0-10).
STORAGE_PROVIDER="local"
# Absolute path outside the web root and outside /public. Required when STORAGE_PROVIDER=local.
# Must stay out of git (see .gitignore).
FILE_STORAGE_DIR="/absolute/path/outside/this/repo/chopda-storage"

# Cloudflare R2 (server-only). Required when STORAGE_PROVIDER=r2. Names only — never commit real values.
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
#
# Note: CLOUDFLARE_API_TOKEN and other CLOUDFLARE_* vars are owner/setup-only
# (dashboard provisioning). Do NOT put them in app env — loadEnv() will not read them.

# --- Scheduled jobs (server-only) ---
# Shared secret checked by Vercel Cron routes (purge, reminders). Dev-only value.
CRON_SECRET="replace-with-a-long-random-dev-only-value"

# --- Bootstrap (server-only, used once by scripts/bootstrap-admin) ---
BOOTSTRAP_ADMIN_USERNAME="admin"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-dev-only-temporary-password"

# Reminder: any variable prefixed NEXT_PUBLIC_ is shipped to the browser.
# Never put a secret, key, token or password in a NEXT_PUBLIC_ variable (see security.yml check).
