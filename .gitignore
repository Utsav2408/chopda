# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.pnpm-store/

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx
*dump*.sql
*.dump

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# local env files — never commit real secrets. .env.example is the only tracked env file.
.env
.env.*
!.env.example

# local file storage (P0-04) — adapter writes here in dev; must never be committed
/storage/
/.data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent tooling — personal/local overrides only, never shared
.claude/settings.local.json
CLAUDE.local.md
.cursor/mcp.json

# editor
.vscode/*
!.vscode/extensions.json
.idea/
.neon
