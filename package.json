{
  "name": "chopda",
  "version": "0.1.0",
  "private": true,
  "description": "Chopda: a private invoice tracker where teams build their own step-by-step flows and track every invoice and its documents through them.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <27.0.0"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "db:check-drift": "tsx scripts/check-migration-drift.ts",
    "storage:smoke": "tsx scripts/storage-smoke.ts",
    "perf:smoke": "tsx scripts/perf-smoke.ts",
    "check:public-env": "tsx scripts/check-public-env-names.ts",
    "check:no-ai": "tsx scripts/check-no-ai-before-phase6.ts",
    "check:server-import-ban": "node scripts/check-server-import-ban.mjs",
    "check:security-headers": "tsx scripts/check-security-headers.ts",
    "crypto:rotate": "tsx scripts/rotate-encryption-key.ts",
    "prepare": "node scripts/setup-git-hooks.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@neon/config": "^1.9.1",
    "@neon/env": "^1.6.1",
    "@vercel/functions": "^3.9.11",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "dotenv": "^18.0.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  }
}
